# Domaine racine : le portfolio est servi dessus, les sites clients sur <slug>.<domaine>.
# En local, *.localhost est résolu automatiquement par le navigateur.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3100

# Postgres (local : Homebrew ou `docker compose up -d` ; prod : Neon via le Marketplace Vercel)
DATABASE_URL=postgres://localhost:5432/professional_website

# E-mails (liens de connexion, notifications de demandes). Sans clé, les e-mails sont affichés dans la console.
RESEND_API_KEY=
EMAIL_FROM="Michael Wautier <bonjour@exemple.fr>"
# Reçoit les demandes de contact du portfolio et a accès à /espace/admin
OWNER_EMAIL=wautiermichael@gmail.com

# Formule Pro (domaine personnalisé). Sans clé, le bouton crée une demande de contact à la place.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Ajout automatique des domaines personnalisés au projet Vercel
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
